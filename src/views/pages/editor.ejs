      margin-bottom: 0.5rem;
    }

    .array-item-title {
      font-weight: 600;
    }

    .remove-array-item {
      background: #dc3545;
      color: white;
      border: none;
      border-radius: 4px;
      padding: 0.25rem 0.5rem;
      cursor: pointer;
