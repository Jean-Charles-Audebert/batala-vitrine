    }

    .tab-btn.active {
      background: white;
      border-bottom: 2px solid #007bff;
      color: #007bff;
    }

    .tab-content {
      flex: 1;
      overflow: auto;
      display: none;
    }

    .tab-content.active {
      display: block;
    }

    .tab-header {
      padding: 1rem;
      border-bottom: 1px solid #e9ecef;
      display: flex;
      justify-content: space-between;
