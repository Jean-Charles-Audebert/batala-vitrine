<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Éditeur de site vitrine">
  <title>Éditeur - <%= title %></title>

  <!-- Fonts -->
  <% if (pageData.page.title_font_id && pageData.fonts) { %>
    <% const titleFont = pageData.fonts.find(f => f.id == pageData.page.title_font_id); %>
    <% if (titleFont && titleFont.font_url) { %>
      <link rel="stylesheet" href="<%= titleFont.font_url %>">
    <% } else if (titleFont && titleFont.file_path) { %>
      <style>
        @font-face {
          font-family: '<%= titleFont.name %>';
          src: url('<%= titleFont.file_path %>');
        }
      </style>
    <% } %>
  <% } %>

  <% if (pageData.page.text_font_id && pageData.fonts) { %>
    <% const textFont = pageData.fonts.find(f => f.id == pageData.page.text_font_id); %>
    <% if (textFont && textFont.font_url) { %>
      <link rel="stylesheet" href="<%= textFont.font_url %>">
    <% } else if (textFont && textFont.file_path) { %>
      <style>
        @font-face {
          font-family: '<%= textFont.name %>';
          src: url('<%= textFont.file_path %>');
        }
      </style>
    <% } %>
  <% } %>

  <!-- Styles -->
  <link rel="stylesheet" href="/css/common.css">
  <link rel="stylesheet" href="/css/editor.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/design-system.css">
  <link rel="stylesheet" href="/css/buttons.css">
  <link rel="stylesheet" href="/css/pages/editor.css">

  <!-- Font Awesome pour les icônes -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
  <div class="editor-container">
    <!-- Header de l'éditeur -->
    <header class="editor-header">
      <div class="header-left">
        <h1 class="editor-title">Éditeur de Site</h1>
        <span class="page-info">Page: <%= pageData.title || 'Sans titre' %></span>
      </div>
      <div class="header-right">
        <button class="btn btn-primary" id="save-btn">
          <i class="fas fa-save"></i> Sauvegarder
        </button>
        <a href="/" class="btn btn-outline" target="_blank">
          <i class="fas fa-external-link-alt"></i> Voir le site
        </a>
      </div>
    </header>

    <!-- Contenu principal de l'éditeur -->
    <div class="editor-content">
      <!-- Zone de prévisualisation -->
      <div class="preview-area">
        <div class="preview-header">
          <h3>Aperçu en direct</h3>
          <div class="preview-controls">
            <!-- Boutons responsive : actuellement cosmétiques, appliquent une classe CSS au conteneur d'aperçu
                 pour simuler différents appareils. Pour une vraie responsivité, il faudrait :
                 - Redimensionner l'iframe selon les breakpoints
                 - Ou utiliser un viewport CSS media queries -->
            <button class="device-btn active" data-device="desktop">
              <i class="fas fa-desktop"></i>
            </button>
            <button class="device-btn" data-device="tablet">
              <i class="fas fa-tablet-alt"></i>
            </button>
            <button class="device-btn" data-device="mobile">
              <i class="fas fa-mobile-alt"></i>
            </button>
          </div>
        </div>
        <div class="preview-frame" id="preview-frame">
          <iframe id="preview-iframe" style="width: 100%; height: 100%; border: none;"></iframe>
        </div>
      </div>

      <!-- Sidebar de configuration -->
      <div class="sidebar">
        <div class="sidebar-tabs">
          <button class="tab-btn active" data-tab="sections">
            <i class="fas fa-layer-group"></i> Sections
          </button>
          <button class="tab-btn" data-tab="elements">
            <i class="fas fa-cubes"></i> Éléments
          </button>
          <button class="tab-btn" data-tab="settings">
            <i class="fas fa-cog"></i> Paramètres
          </button>
        </div>

        <!-- Onglet Sections -->
        <div class="tab-content active" id="sections-tab">
          <div class="tab-header">
            <h4>Sections de la page</h4>
            <button class="btn btn-small btn-primary" id="add-section-btn">
              <i class="fas fa-plus"></i> Ajouter
            </button>
          </div>
          <div class="sections-list" id="sections-list">
            <% pageData.sections.forEach(section => { %>
              <div class="section-item" data-section-id="<%= section.id %>">
                <div class="section-info">
                  <span class="section-type"><%= section.type %></span>
                  <span class="section-title"><%= section.title || 'Sans titre' %></span>
                </div>
                <div class="section-actions">
                  <button class="action-btn edit-btn" title="Modifier">
                    <i class="fas fa-edit"></i>
                  </button>
                  <button class="action-btn visibility-btn <%= section.is_visible ? 'visible' : 'hidden' %>" title="Visibilité">
                    <i class="fas fa-eye<%= section.is_visible ? '' : '-slash' %>"></i>
                  </button>
                  <button class="action-btn delete-btn" title="Supprimer">
                    <i class="fas fa-trash"></i>
                  </button>
                </div>
              </div>
            <% }); %>
          </div>
        </div>

        <!-- Onglet Éléments -->
        <div class="tab-content" id="elements-tab">
          <div class="tab-header">
            <h4>Éléments sélectionnés</h4>
          </div>
          <div class="elements-list" id="elements-list">
            <div class="no-selection">
              <i class="fas fa-mouse-pointer"></i>
              <p>Sélectionnez un élément dans l'aperçu</p>
            </div>
          </div>
        </div>

        <!-- Onglet Paramètres -->
        <div class="tab-content" id="settings-tab">
          <div class="tab-header">
            <h4>Paramètres de la page</h4>
          </div>
          <div class="settings-form">
            <div class="form-group">
              <label for="page-title">Titre de la page</label>
              <input type="text" id="page-title" value="<%= pageData.page.title || '' %>">
            </div>
            <hr>
            <div class="form-group">
              <label for="page-contact-email">Email de contact</label>
              <input type="email" id="page-contact-email" value="<%= pageData.page.contact_email || '' %>">
            </div>
            <hr>
            <div class="form-group">
              <label for="page-main-bg-color">Couleur de fond principale</label>
              <input type="color" id="page-main-bg-color" value="<%= pageData.page.main_bg_color || '#f5f5f5' %>">
            </div>
            <hr>
            <div class="form-group">
              <label for="page-main-bg-media-url">Média de fond</label>
              <div class="media-upload-field">
                <input type="text" id="page-main-bg-media-url" name="main_bg_media_url" value="<%= pageData.page.main_bg_media_url || '' %>" placeholder="/uploads/... ou URL externe" readonly>
                <button type="button" class="btn btn-sm btn-secondary select-bg-media">
                  <i class="fas fa-image"></i> Choisir
                </button>
                <% if (pageData.page.main_bg_media_url) { %>
                <button type="button" class="btn btn-sm btn-danger clear-bg-media">
                  <i class="fas fa-trash"></i>
                </button>
                <% } %>
              </div>
            </div>
            <hr>
            <div class="form-group">
              <label for="page-main-bg-youtube-url">URL YouTube de fond</label>
              <input type="text" id="page-main-bg-youtube-url" value="<%= pageData.page.main_bg_youtube_url || '' %>" placeholder="URL YouTube">
            </div>
            <hr>
            <div class="form-group">
              <label for="page-main-bg-opacity">Opacité du fond (0-1)</label>
              <input type="number" id="page-main-bg-opacity" min="0" max="1" step="0.1" value="<%= pageData.page.main_bg_opacity || 1.0 %>">
            </div>
            <hr>
            <div class="form-group">
              <label for="page-main-bg-position">Position du fond</label>
              <select id="page-main-bg-position">
                <option value="center" <%= (pageData.page.main_bg_position === 'center') ? 'selected' : '' %>>Centre</option>
                <option value="top" <%= (pageData.page.main_bg_position === 'top') ? 'selected' : '' %>>Haut</option>
                <option value="bottom" <%= (pageData.page.main_bg_position === 'bottom') ? 'selected' : '' %>>Bas</option>
                <option value="left" <%= (pageData.page.main_bg_position === 'left') ? 'selected' : '' %>>Gauche</option>
                <option value="right" <%= (pageData.page.main_bg_position === 'right') ? 'selected' : '' %>>Droite</option>
              </select>
            </div>
            <hr>
            <div class="form-group">
              <label for="page-title-font-id">Police du titre</label>
              <select id="page-title-font-id">
                <option value="">Aucune</option>
                <% if (pageData.fonts) { %>
                  <% pageData.fonts.forEach(font => { %>
                    <option value="<%= font.id %>" <%= (pageData.page.title_font_id == font.id) ? 'selected' : '' %>><%= font.name %> (<%= font.source %>)</option>
                  <% }); %>
                <% } %>
              </select>
            </div>
            <hr>
            <div class="form-group">
              <label for="page-text-font-id">Police du texte</label>
              <select id="page-text-font-id">
                <option value="">Aucune</option>
                <% if (pageData.fonts) { %>
                  <% pageData.fonts.forEach(font => { %>
                    <option value="<%= font.id %>" <%= (pageData.page.text_font_id == font.id) ? 'selected' : '' %>><%= font.name %> (<%= font.source %>)</option>
                  <% }); %>
                <% } %>
              </select>
            </div>

            <div class="form-actions">
              <button type="button" class="btn btn-secondary manage-fonts-btn">
                <i class="fas fa-font"></i> Gérer les polices
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modales -->
  <!-- Modale d'ajout/édition de section -->
  <div class="modal" id="section-modal">
    <div class="modal-content large-modal">
      <div class="modal-header">
        <h3 id="section-modal-title">Ajouter une section</h3>
        <button class="modal-close">&times;</button>
      </div>
      <div class="modal-body">
        <div class="section-form-container">
          <!-- Sélecteur de type de section (uniquement pour ajout) -->
          <div class="form-group" id="section-type-selector">
            <label for="section-type">Type de section</label>
            <select id="section-type" required>
              <option value="hero">🏠 Hero</option>
              <option value="textMedia">📝 Texte + Média</option>
              <option value="cards">🎴 Grille de cartes</option>
            </select>
          </div>

          <!-- Formulaire dynamique généré selon le schéma -->
          <div id="section-dynamic-form">
            <!-- Les champs seront générés dynamiquement ici -->
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" id="section-cancel-btn">Annuler</button>
        <button class="btn btn-primary" id="section-save-btn">Sauvegarder</button>
      </div>
    </div>
  </div>

  <!-- Modale d'édition d'élément -->
  <div class="modal" id="element-edit-modal">
    <div class="modal-content">
      <div class="modal-header">
        <h3 id="element-modal-title">Modifier l'élément</h3>
        <button class="modal-close">&times;</button>
      </div>
      <div class="modal-body">
        <form id="element-edit-form">
          <input type="hidden" id="element-id" name="id">
          
          <div class="form-group">
            <label for="element-title">Titre</label>
            <input type="text" id="element-title" name="title" required>
          </div>
          
          <div class="form-group">
            <label for="element-font-id">Police</label>
            <select id="element-font-id" name="font_id">
              <option value="">Police par défaut</option>
              <% if (pageData.fonts) { %>
                <% pageData.fonts.forEach(font => { %>
                  <option value="<%= font.id %>"><%= font.name %> (<%= font.source %>)</option>
                <% }); %>
              <% } %>
            </select>
          </div>
          
          <!-- Champs spécifiques selon le type d'élément -->
          <div id="element-specific-fields">
            <!-- Les champs spécifiques seront ajoutés dynamiquement par JavaScript -->
          </div>
          
          <div class="form-actions">
            <button type="button" class="btn btn-secondary" id="element-cancel-btn">Annuler</button>
            <button type="button" class="btn btn-primary" id="element-save-btn">Sauvegarder</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- CSS Variables pour les polices (nécessaires pour l'injection dans l'iframe) -->
  <link rel="stylesheet" href="/editor/css/pages/dynamic-variables.css">
  <script src="/js/media-picker.js"></script>
  <!-- Scripts des classes de l'éditeur -->
  <script src="/js/editor/PreviewManager.js"></script>
  <script src="/js/editor/FormGenerator.js"></script>
  <script src="/js/editor/SectionManager.js"></script>
  <script>
    // Données des polices disponibles pour l'aperçu dynamique
    window.fontsData = <%- JSON.stringify(pageData.fonts || []) %>;
    // Schéma des sections pour la génération dynamique des formulaires
    window.sectionSchemas = <%- JSON.stringify(pageData.schemas) %>;
    // Données complètes de la page pour l'éditeur
    window.pageData = <%- JSON.stringify(pageData) %>;
  </script>
  <script src="/js/pages/editor.js"></script>
</body>
</html>