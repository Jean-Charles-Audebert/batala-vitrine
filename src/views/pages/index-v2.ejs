<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= page.title || 'Mon Site' %>">
  <title><%= title %> | <%= page.title || 'Mon Site' %></title>
  
  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/icons/favicon.ico">
  
  <!-- Fonts -->
  <%
    const titleFont = (page.default_font_title && fonts) ? fonts.find(f => f.id == page.default_font_title) : null;
    const textFont = (page.default_font_text && fonts) ? fonts.find(f => f.id == page.default_font_text) : null;
  %>
  
  <% if (titleFont && titleFont.url) { %>
    <link rel="stylesheet" href="<%= titleFont.url %>">
  <% } %>
  <% if (textFont && textFont.url) { %>
    <link rel="stylesheet" href="<%= textFont.url %>">
  <% } %>
  
  <!-- Styles -->
  <link rel="stylesheet" href="/css/core.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/sections.css">
  <link rel="stylesheet" href="/css/page.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.0/css/all.min.css">
  
  <!-- CSS Variables -->
  <style>
    :root {
      --default-font-title: <%= titleFont?.font_family ? `'${titleFont.font_family}'` : 'Arial' %>, sans-serif;
      --default-font-text: <%= textFont?.font_family ? `'${textFont.font_family}'` : '-apple-system' %>, sans-serif;
    }
    body {
      background-color: <%= page.settings?.bg_color || page.bg_color || '#f5f5f5' %>;
    }
  </style>
</head>
<body class="vitrine-page">
  <!-- PAGE BACKGROUND MEDIA -->
  <%
    const bgImageStyle = page.bg_image 
      ? `position:fixed;top:0;left:0;width:100vw;height:100vh;z-index:-2;pointer-events:none;background-image:url('${page.bg_image}');background-repeat:${page.bg_image_repeat || 'no-repeat'};background-size:${page.bg_image_size || 'cover'};background-position:${page.bg_position || 'center'};background-attachment:fixed;`
      : '';
    const isLocalVideo = page.bg_image && isVideoFilePath(page.bg_image);
  %>
  
  <!-- Local video background -->
  <% if (isLocalVideo) { %>
    <video class="section-bg-video global-bg-video" autoplay muted loop playsinline style="position:fixed;top:0;left:0;width:100vw;height:100vh;object-fit:cover;z-index:-1;pointer-events:none;">
      <source src="<%= page.bg_image %>" type="video/mp4">
    </video>
  <% } else if (bgImageStyle) { %>
    <div class="global-bg-image" style="<%= bgImageStyle %>"></div>
  <% } %>
  
  <!-- Remote video background -->
  <% if (page.bg_video) { %>
    <video class="section-bg-video global-bg-video" autoplay muted loop playsinline style="position:fixed;top:0;left:0;width:100vw;height:100vh;object-fit:cover;z-index:-1;pointer-events:none;">
      <source src="<%= page.bg_video %>" type="video/mp4">
    </video>
  <% } %>
  
  <!-- YouTube background -->
  <% if (page.bg_video_youtube) { %>
    <% const videoId = extractYouTubeIdServer(page.bg_video_youtube); %>
    <% if (videoId) { %>
      <iframe class="section-bg-youtube global-bg-youtube" src="https://www.youtube.com/embed/<%= videoId %>?autoplay=1&mute=1&loop=1&playlist=<%= videoId %>&controls=0&rel=0&modestbranding=1&playsinline=1" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen style="position:fixed;top:0;left:0;width:100vw;height:100vh;z-index:-1;pointer-events:none;"></iframe>
    <% } %>
  <% } %>
  
  <!-- MAIN CONTENT -->
  <div class="main-content-wrapper">
    <% sections.forEach(section => { %>
      <% const sectionType = section.layout?.type || section.type || 'content'; %>
      
      <!-- Skip footer (rendered at end) -->
      <% if (sectionType === 'footer') { return; } %>
      
      <!-- Render hero -->
      <% if (sectionType === 'hero') { %>
        <section id="section-<%= section.id %>" class="section-wrapper section-hero-wrapper">
          <%- include('../components/sections/hero', { section, socialLinks }) %>
        </section>
      <% } else { %>
        <!-- Render standard/other sections -->
        <section id="section-<%= section.id %>" class="section-wrapper">
          <%- include('../components/sections/standard', { section }) %>
        </section>
      <% } %>
    <% }) %>
  </div>
  
  <!-- FOOTER SECTION -->
  <% sections.forEach(section => { %>
    <% if (section.type === 'footer') { %>
      <section id="section-<%= section.id %>" class="section-wrapper">
        <%- include('../components/sections/footer', { section, user, socialLinks }) %>
      </section>
    <% } %>
  <% }) %>
  
  <!-- AUTH FAB -->
  <%- include('../components/auth-fab', { user }) %>
  
  <!-- SCRIPTS -->
  <script src="/js/index.js"></script>
</body>
</html>
