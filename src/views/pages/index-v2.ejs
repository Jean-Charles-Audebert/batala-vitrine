<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= page.title || 'Mon Site' %>">
  <title><%= title %> | <%= page.title || 'Mon Site' %></title>
  
  <!-- Fonts -->
  <% if (page.title_font_id && fonts) { %>
    <% const titleFont = fonts.find(f => f.id == page.title_font_id); %>
    <% if (titleFont && titleFont.font_url) { %>
      <link rel="stylesheet" href="<%= titleFont.font_url %>">
    <% } else if (titleFont && titleFont.file_path) { %>
      <style>
        @font-face {
          font-family: '<%= titleFont.name %>';
          src: url('<%= titleFont.file_path %>');
        }
      </style>
    <% } %>
  <% } %>

  <% if (page.text_font_id && fonts) { %>
    <% const textFont = fonts.find(f => f.id == page.text_font_id); %>
    <% if (textFont && textFont.font_url) { %>
      <link rel="stylesheet" href="<%= textFont.font_url %>">
    <% } else if (textFont && textFont.file_path) { %>
      <style>
        @font-face {
          font-family: '<%= textFont.name %>';
          src: url('<%= textFont.file_path %>');
        }
      </style>
    <% } %>
  <% } %>
  
  <!-- Styles -->
  <link rel="stylesheet" href="/css/index.css">
  <link rel="stylesheet" href="/css/page.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- CSS Variables pour thème global -->

  <style>
    :root {
      <% if (page.default_font_title) { %>
        --default-font-title: var(--font-<%= page.default_font_title %>);
      <% } %>
      <% if (page.default_font_text) { %>
        --default-font-text: var(--font-<%= page.default_font_text %>);
      <% } %>
    }
  </style>
</head>
<body class="vitrine-page">
  <%
    let bgImageStyle = '';
    if (page.main_bg_image) {
      bgImageStyle = `position:fixed;top:0;left:0;width:100vw;height:100vh;z-index:-2;pointer-events:none;background-image:url('${page.main_bg_image}');background-repeat:${page.main_bg_image_repeat || 'no-repeat'};background-size:${page.main_bg_image_size || 'cover'};background-position:center;background-attachment:fixed;`;
    }
  %>
  <% if (bgImageStyle) { %>
    <div class="global-bg-image" style="<%= bgImageStyle %>"></div>
  <% } %>
  <% if (page.main_bg_video) { %>
    <video class="section-bg-video global-bg-video" autoplay muted loop playsinline style="position:fixed;top:0;left:0;width:100vw;height:100vh;object-fit:cover;z-index:-1;pointer-events:none;">
      <source src="<%= page.main_bg_video %>" type="video/mp4">
    </video>
  <% } else if (page.main_bg_youtube) { %>
    <% /* Extraction ID YouTube */ %>
    <% let videoId = '';
      try {
        if (page.main_bg_youtube.includes('youtu.be/')) {
          videoId = page.main_bg_youtube.split('youtu.be/')[1].split('?')[0].split('&')[0];
        } else if (page.main_bg_youtube.includes('youtube.com/watch')) {
          const url = new URL(page.main_bg_youtube);
          videoId = url.searchParams.get('v');
        } else if (page.main_bg_youtube.includes('youtube.com/embed/')) {
          videoId = page.main_bg_youtube.split('embed/')[1].split('?')[0].split('&')[0];
        } else if (page.main_bg_youtube.includes('youtube.com/shorts/')) {
          videoId = page.main_bg_youtube.split('shorts/')[1].split('?')[0].split('&')[0];
        }
      } catch (e) {}
    %>
    <% if (videoId) { %>
      <iframe class="section-bg-youtube global-bg-youtube" src="https://www.youtube.com/embed/<%= videoId %>?autoplay=1&mute=1&loop=1&playlist=<%= videoId %>&controls=0&rel=0&modestbranding=1&playsinline=1" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen style="position:fixed;top:0;left:0;width:100vw;height:100vh;z-index:-1;pointer-events:none;"></iframe>
    <% } %>
  <% } %>
  
  <!-- SECTIONS V2 -->
  <div class="main-content-wrapper">
    <% sections.forEach(section => { %>
      <% 
        const sectionType = section.layout?.type || section.type || 'content';
        const sectionLayout = section.layout || {};
      %>
      <% if (sectionType === 'footer') { return; } %>
      <% if (sectionType === 'hero') { %>
        <section id="section-<%= section.id %>" class="section-wrapper section-hero-wrapper">
          <%- include('../components/sections/hero', { section, socialLinks }) %>
        </section>
      <% } else { %>
        <section id="section-<%= section.id %>" class="section-wrapper">
          <%- include('../components/sections/standard', { section }) %>
        </section>
      <% } %>
    <% }) %>
  </div>
  <% sections.forEach(section => { if (section.type === 'footer') { %>
    <section id="section-<%= section.id %>" class="section-wrapper">
      <%- include('../components/sections/footer', { section, user, socialLinks }) %>
    </section>
  <% } }) %>
  
  <!-- FAB Auth -->
  <%- include('../components/auth-fab', { user }) %>
  
  <!-- Scripts -->
  <script src="/js/index.js"></script>
  <script src="/js/image-upload.js"></script>
  <script src="/js/contact-form.js"></script>
  
  <!-- Gallery Video Handler -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Handle video thumbnail clicks
      document.addEventListener('click', function(e) {
        const videoThumbWrapper = e.target.closest('.video-thumb-wrapper');
        if (videoThumbWrapper) {
          e.preventDefault();
          const videoId = videoThumbWrapper.dataset.videoId;
          if (videoId) {
            // Replace thumbnail with YouTube iframe
            const iframe = document.createElement('iframe');
            iframe.src = `https://www.youtube.com/embed/${videoId}?rel=0&autoplay=1`;
            iframe.frameBorder = '0';
            iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
            iframe.allowFullscreen = true;
            iframe.className = 'youtube-iframe';
            iframe.style.width = '100%';
            iframe.style.height = '100%';
            iframe.style.border = 'none';
            iframe.style.borderRadius = 'var(--border-radius-md)';
            
            videoThumbWrapper.innerHTML = '';
            videoThumbWrapper.appendChild(iframe);
          }
        }
      });
    });
  </script>
  
  <% if (user) { %>
    <!-- FAB Add Section -->
    <button id="fabAddSection" class="fab-add-section" aria-label="Ajouter une section" title="Ajouter une section">
      ➕
    </button>
    <!-- Indique au JS que l'utilisateur est connecté (admin unique) -->
    <script>window.userIsAdmin = true;</script>
    <script type="module" src="/js/sections-edit.js"></script>
    <script>
      console.log('✅ Mode admin activé - sections v2');
      console.log('💡 Cliquez sur les boutons ✏️ pour éditer');
    </script>
  <% } %>
</body>
</html>
