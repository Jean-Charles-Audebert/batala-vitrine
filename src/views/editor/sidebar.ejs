<div class="editor-sidebar-header">
  <h2>Éditeur</h2>
  <button id="closeSidebar" class="editor-sidebar-close" title="Fermer le panneau">
    <img src="/icons/close.svg" alt="Fermer" class="icon">
  </button>
</div>

<div class="editor-sidebar-content">
  <!-- Actions principales -->
  <div class="sidebar-actions-main">
    <button class="btn btn-primary btn-lg add-section-btn">
      <img src="/icons/add.svg" alt="" class="icon"> Ajouter une section
    </button>
    <button class="btn btn-secondary btn-lg" data-tab="global">
      <img src="/icons/settings.svg" alt="" class="icon"> Configuration globale
    </button>
    <button class="btn btn-secondary btn-lg" data-tab="fonts">
      <img src="/icons/font.svg" alt="" class="icon"> Polices
    </button>
  </div>

  <!-- Liste des sections -->
  <div class="sections-container">
    <h3 class="sections-title">
      <img src="/icons/layout.svg" alt="" class="icon"> Sections de la page
    </h3>

    <div class="sections-list" id="sectionsList">
      <!-- Les sections seront générées dynamiquement par JS -->
    </div>
  </div>

  <!-- Configuration globale (masquée par défaut) -->
  <div class="global-config-panel" id="globalConfigPanel" style="display: none;">
    <div class="panel-header">
      <button class="btn btn-sm btn-secondary back-to-main">
        <img src="/icons/arrow-left.svg" alt="" class="icon"> Retour
      </button>
      <h3>Configuration globale</h3>
    </div>

    <form id="globalForm" class="editor-form">
      <div class="form-section">
        <h4>Police principale</h4>
        <div class="form-group">
          <label for="globalFont">Police</label>
          <select id="globalFont" name="title_font_id">
            <option value="">— Police par défaut —</option>
            <% if (fonts && fonts.length > 0) { %>
              <% fonts.forEach(font => { %>
            <option value="<%= font.id %>" <%= config.global.title_font_id == font.id ? 'selected' : '' %>>
              <%= font.name %>
            </option>
              <% }); %>
            <% } %>
          </select>
        </div>
      </div>

      <div class="form-section">
        <h4>Fond principal</h4>
        <div class="form-group">
          <label for="globalBgColor">Couleur de fond</label>
          <input type="color" id="globalBgColor" name="main_bg_color" value="<%= config.global.main_bg_color || '#f5f5f5' %>">
        </div>

        <div class="form-group">
          <label for="globalBgImage">Image de fond</label>
          <div class="media-upload-field">
            <input type="text" id="globalBgImage" name="main_bg_image" value="<%= config.global.main_bg_image || '' %>" placeholder="/uploads/..." readonly>
            <button type="button" class="btn btn-sm btn-secondary select-global-bg">
              <img src="/icons/image.svg" alt="" class="icon"> Choisir
            </button>
            <% if (config.global.main_bg_image) { %>
            <button type="button" class="btn btn-sm btn-danger clear-global-bg">
              <img src="/icons/trash.svg" alt="" class="icon">
            </button>
            <% } %>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="globalBgRepeat">Répétition</label>
            <select id="globalBgRepeat" name="main_bg_image_repeat">
              <option value="no-repeat" <%= (config.global.main_bg_image_repeat || 'no-repeat') === 'no-repeat' ? 'selected' : '' %>>Aucune</option>
              <option value="repeat" <%= config.global.main_bg_image_repeat === 'repeat' ? 'selected' : '' %>>Répéter</option>
              <option value="repeat-x" <%= config.global.main_bg_image_repeat === 'repeat-x' ? 'selected' : '' %>>Horizontal</option>
              <option value="repeat-y" <%= config.global.main_bg_image_repeat === 'repeat-y' ? 'selected' : '' %>>Vertical</option>
            </select>
          </div>
          <div class="form-group">
            <label for="globalBgSize">Taille</label>
            <select id="globalBgSize" name="main_bg_image_size">
              <option value="cover" <%= (config.global.main_bg_image_size || 'cover') === 'cover' ? 'selected' : '' %>>Couvrir</option>
              <option value="contain" <%= config.global.main_bg_image_size === 'contain' ? 'selected' : '' %>>Contenir</option>
              <option value="auto" <%= config.global.main_bg_image_size === 'auto' ? 'selected' : '' %>>Auto</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label for="globalBgVideo">Vidéo de fond (MP4)</label>
          <div class="media-upload-field">
            <input type="text" id="globalBgVideo" name="main_bg_video" value="<%= config.global.main_bg_video || '' %>" placeholder="/uploads/video.mp4" readonly>
            <button type="button" class="btn btn-sm btn-secondary select-global-video">
              <img src="/icons/video.svg" alt="" class="icon"> Choisir
            </button>
            <% if (config.global.main_bg_video) { %>
            <button type="button" class="btn btn-sm btn-danger clear-global-video">
              <img src="/icons/trash.svg" alt="" class="icon">
            </button>
            <% } %>
          </div>
        </div>

        <div class="form-group">
          <label for="globalBgYoutube">Vidéo YouTube</label>
          <input type="text" id="globalBgYoutube" name="main_bg_youtube" value="<%= config.global.main_bg_youtube || '' %>" placeholder="https://youtu.be/...">
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Sauvegarder</button>
      </div>
    </form>
  </div>

  <!-- Gestion des polices (masquée par défaut) -->
  <div class="fonts-panel" id="fontsPanel" style="display: none;">
    <div class="panel-header">
      <button class="btn btn-sm btn-secondary back-to-main">
        <img src="/icons/arrow-left.svg" alt="" class="icon"> Retour
      </button>
      <h3>Gestion des polices</h3>
    </div>

    <div class="fonts-content">
      <div class="fonts-actions">
        <button class="btn btn-primary" data-action="add-google-font">
          <img src="/icons/add.svg" alt="" class="icon"> Ajouter police Google
        </button>
        <button class="btn btn-secondary" data-action="upload-font">
          <img src="/icons/upload.svg" alt="" class="icon"> Uploader police
        </button>
      </div>

      <div class="fonts-list" id="fontsList">
        <% if (fonts && fonts.length > 0) { %>
          <% fonts.forEach(font => { %>
        <div class="font-item" data-font-id="<%= font.id %>">
          <div class="font-info">
            <span class="font-name" style="font-family: '<%= font.font_family || 'inherit' %>';"><%= font.name %></span>
            <span class="font-source"><%= font.source === 'google' ? 'Google Fonts' : 'Uploadée' %></span>
          </div>
          <div class="font-actions">
            <button class="btn btn-sm btn-danger" data-action="delete-font" data-font-id="<%= font.id %>">
              <img src="/icons/trash.svg" alt="" class="icon">
            </button>
          </div>
        </div>
          <% }); %>
        <% } else { %>
        <p class="empty-state">Aucune police trouvée</p>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Éditeur de section (sera affiché dynamiquement) -->
  <div class="section-editor" id="sectionEditor" style="display: none;">
    <div class="section-editor-header">
      <button id="backToSections" class="btn btn-secondary btn-sm">
        <img src="/icons/arrow-left.svg" alt="" class="icon"> Retour
      </button>
      <h3 id="sectionEditorTitle">Modifier la section</h3>
    </div>

    <form id="sectionForm" class="editor-form">
      <!-- Les champs seront générés dynamiquement par JS -->
    </form>

    <div class="form-actions">
      <button type="button" class="btn btn-secondary editor-sidebar-cancel">Annuler</button>
      <button type="button" class="btn editor-sidebar-save">Sauvegarder</button>
    </div>
  </div>
</div>