<%
// =====================================================
// Standard Section - Version nettoyée
// Lecture depuis: section.settings (JSONB) + elements
// =====================================================
const s = section.settings || {};

// --- SETTINGS (from JSONB) ---
const sectionTitle = s.title || '';
const titleFont = s.title_font;
const titleSize = s.title_size || 32;
const titleColor = s.title_color || '#333';
const show_title = s.show_title !== false;
const align = s.align || 'center';

// Background
const bg_color = s.bg_color || '#ffffff';
const bg_image = s.bg_image;
const bg_video = s.bg_video;
const bg_youtube = s.bg_youtube;
const is_transparent = s.bg_transparent || false;

// Layout
const layout = s.layout || '12-cols-grid';

// --- ELEMENTS (from elements table) ---
const id = section.id;
const elements = section.elements || [];

// Build styles
const sectionStyles = [];
if (!is_transparent && bg_color) {
  sectionStyles.push(`background-color: ${bg_color}`);
}
if (bg_image) {
  sectionStyles.push(`background-image: url(${bg_image})`);
  sectionStyles.push(`background-size: cover`);
  sectionStyles.push(`background-position: center`);
}

const sectionClasses = ['section', 'section-standard'];
if (is_transparent) sectionClasses.push('section-transparent');
%>
<section class="<%= sectionClasses.join(' ') %>" data-section-id="<%= id %>" <% if (sectionStyles.length > 0) { %>style="<%= sectionStyles.join('; ') %>"<% } %>>
  <!-- Arrière-plan média -->
  <% if (bg_youtube) { %>
    <% const videoId = extractYouTubeIdServer(bg_youtube); %>
    <% if (videoId) { %>
      <iframe class="section-bg-youtube" src="https://www.youtube.com/embed/<%= videoId %>?autoplay=1&mute=1&loop=1&playlist=<%= videoId %>&controls=0&rel=0&modestbranding=1&playsinline=1" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
    <% } %>
  <% } else if (bg_video) { %>
    <video class="section-bg-video" autoplay muted loop playsinline>
      <source src="<%= bg_video %>" type="video/mp4">
    </video>
  <% } %>

  <div class="section-content">
    <!-- Titre section (from settings) -->
    <% if (sectionTitle && show_title) { %>
      <div class="section-title-container text-<%= align %>">
        <h2 class="section-title font-title-default"
            style="color: <%= titleColor %>; font-size: <%= titleSize %>px;"
            data-section-id="<%= id %>">
          <%= sectionTitle %>
        </h2>
      </div>
    <% } %>

    <!-- Grille 12 colonnes pour les éléments -->
    <div class="elements-grid">
      <%
        // Collecter les éléments gallery et youtube séparément
        const galleryImages = [];
        const galleryVideos = [];
        
        elements.forEach(element => {
          if (element.type === 'gallery') {
            galleryImages.push(element);
          } else if (element.type === 'youtube') {
            galleryVideos.push(element);
          } else {
            // Rendre les autres éléments normalement
            const settings = element.settings || {};
            const colStart = element.col_start || 1;
            const colEnd = element.col_end || 13;
            const colSpan = colEnd - colStart;
            const align = settings.align || 'center';

            // Classes pour la grille
            const elementClasses = [
              'element-item',
              `element-${element.type}`,
              `col-start-${colStart}`,
              `col-span-${colSpan}`
            ];

            // Classes de police
            let fontTitleClass = 'font-title-default';
            let fontTextClass = 'font-text-default';

            if (settings.font_id) {
              fontTitleClass = `font-${settings.font_id}`;
              fontTextClass = `font-${settings.font_id}`;
            }

            // Pour la première card, utiliser des polices personnalisées pour test
            if (element.type === 'card' && elements.filter(el => el.type === 'card').indexOf(element) === 0) {
              fontTitleClass = 'font-custom-title';
              fontTextClass = 'font-custom-text';
            }
      %>
        <div class="<%= elementClasses.join(' ') %>" data-element-id="<%= element.id %>">
          <% if (element.type === 'text') { %>
            <div class="element-text">
              <% if (settings.title) { %>
                <h3 class="<%= fontTitleClass %> text-<%= align %>"><%= settings.title %></h3>
              <% } %>
              <% if (settings.content) { %>
                <div class="<%= fontTextClass %>"><%= settings.content %></div>
              <% } %>
            </div>
          <% } else if (element.type === 'media') { %>
            <div class="element-media">
              <% if (settings.video_url) { %>
                <div class="video-wrapper">
                  <%
                    const mediaVideoId = extractYouTubeIdServer(settings.video_url);
                  %>
                  <% if (mediaVideoId) { %>
                    <iframe src="https://www.youtube.com/embed/<%= mediaVideoId %>?rel=0" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                  <% } else { %>
                    <iframe src="<%= settings.video_url.replace('watch?v=', 'embed/').replace('youtu.be/', 'youtube.com/embed/') %>" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                  <% } %>
                </div>
              <% } else if (settings.url || settings.image_url || settings.media_url) { %>
                <img src="<%= settings.url || settings.image_url || settings.media_url %>" alt="<%= settings.alt || settings.title || 'Média' %>" class="media-image">
              <% } %>
            </div>
          <% } else if (element.type === 'card') { %>
            <article class="element-card">
              <% if (settings.image_url || settings.media_url) { %>
                <div class="card-media">
                  <% if (settings.media_type === 'youtube' || settings.video_url) { %>
                    <div class="video-wrapper">
                      <%
                        const cardVideoId = extractYouTubeIdServer(settings.video_url || settings.media_url);
                      %>
                      <% if (cardVideoId) { %>
                        <iframe src="https://www.youtube.com/embed/<%= cardVideoId %>?rel=0" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                      <% } else { %>
                        <iframe src="<%= (settings.video_url || settings.media_url).replace('watch?v=', 'embed/').replace('youtu.be/', 'youtube.com/embed/') %>" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                      <% } %>
                    </div>
                  <% } else { %>
                    <img src="<%= settings.image_url || settings.media_url %>" alt="<%= settings.title || element.title || '' %>" class="card-image">
                  <% } %>
                </div>
              <% } %>
              <div class="card-content">
                <% if (settings.title && settings.title.text) { %>
                  <h3 class="<%= fontTitleClass %> text-<%= align %>"><%= settings.title.text %></h3>
                <% } %>
                <% if (settings.description && settings.description.text) { %>
                  <p class="<%= fontTextClass %>"><%= settings.description.text %></p>
                <% } %>
                <% if (settings.event_date) { %>
                  <time datetime="<%= new Date(settings.event_date).toISOString() %>" class="<%= fontTextClass %>">
                    <%= new Date(settings.event_date).toLocaleDateString('fr-FR') %>
                  </time>
                <% } %>
                <% if (settings.link_url) { %>
                  <a href="<%= settings.link_url %>" class="card-link <%= fontTextClass %>">En savoir plus</a>
                <% } %>
              </div>
            </article>
          <% } %>
        </div>
      <%
          }
        });
      %>
      
      <!-- Galerie : images d'abord -->
      <% if (galleryImages.length > 0) { %>
        <div class="gallery-images">
          <% galleryImages.forEach(element => { %>
            <div class="gallery-thumb">
              <a href="<%= element.settings.media_url %>" target="_blank">
                <img src="<%= element.settings.media_url %>" alt="<%= element.settings.alt || element.settings.title || '' %>">
              </a>
            </div>
          <% }); %>
        </div>
      <% } %>
      
      <!-- Galerie : vidéos YouTube ensuite -->
      <% if (galleryVideos.length > 0) { %>
        <div class="gallery-videos">
          <% galleryVideos.forEach(element => { %>
            <%
              const youtubeUrl = element.settings.url || element.settings.video_url || element.settings.youtube_url;
              const youtubeId = extractYouTubeIdServer(youtubeUrl);
            %>
            <% if (youtubeId) { %>
              <div class="gallery-video">
                <iframe src="https://www.youtube.com/embed/<%= youtubeId %>?rel=0" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
              </div>
            <% } %>
          <% }); %>
        </div>
      <% } %>
    </div>
  </div>
</section>