<%
/**
 * Composant Section Hero - Version modulaire avec elements
 */

// Trouver les éléments pertinents
const logoElement = section.elements?.find(el => el.type === 'media' && el.settings?.media_url?.includes('logo')) || {};
const socialMediaElement = section.elements?.find(el => el.type === 'media' && el.settings?.social_icons) || {};
const navElements = section.elements?.filter(el => el.type === 'link' && el.settings?.link_type === 'navigation') || [];

// Positions depuis les propriétés des éléments
const logo_position_h = logoElement.settings?.align || 'left';
const logo_position_v = logoElement.settings?.vertical_align || 'center';
const nav_position_h = navElements.length > 0 ? navElements[0].settings?.align || 'center' : 'center';
const nav_position_v = navElements.length > 0 ? navElements[0].settings?.vertical_align || 'bottom' : 'bottom';
const social_position_h = socialMediaElement.settings?.align || 'right';
const social_position_v = socialMediaElement.settings?.vertical_align || 'center';

// Fonction helper pour convertir les positions en classes CSS
function getPositionClasses(hPos, vPos) {
  const colMap = { 
    'left': ['col-start-1', 'col-span-4'], 
    'center': ['col-start-6', 'col-span-4'], 
    'right': ['col-start-11', 'col-span-4'] 
  };
  const rowMap = { 'top': 'row-1', 'center': 'row-2', 'bottom': 'row-3' };

  const cols = colMap[hPos] || ['col-start-1', 'col-span-4'];
  const row = rowMap[vPos] || 'row-2';
  
  return [...cols, row];
}

// Configuration du logo depuis l'élément
const logo_url = logoElement.settings?.media_url;
const logoClasses = ['hero-logo', ...getPositionClasses(logo_position_h, logo_position_v)];

// Configuration des liens de navigation
const navClasses = ['hero-nav', ...getPositionClasses(nav_position_h, nav_position_v)];

// Configuration des liens sociaux depuis l'élément
const socialElements = socialMediaElement.settings?.social_icons || [];
const socialClasses = ['hero-social', ...getPositionClasses(social_position_h, social_position_v)];

// Configuration de la section depuis settings JSONB
const sectionSettings = section.settings || {};
const {
  bg_color = '#1a1a1a',
  bg_image,
  bg_video,
  bg_youtube,
  is_transparent = false,
  layout = 'center',
  logo_width = logoElement.settings?.width || 150,
  social_icon_size = section.social_icon_size || 24,
  social_icon_color = section.social_icon_color || '#ffffff',
  show_nav_links = section.show_nav_links || navElements.length > 0,
  nav_text_color = section.nav_text_color || '#ffffff',
  nav_bg_color = section.nav_bg_color || 'rgba(255,255,255,0.25)',
  is_sticky = section.is_sticky || false,
  title: sectionTitle,
  title_color: sectionTitleColor,
  align = 'center',
  vertical_align = 'center'
} = sectionSettings;

// Styles pour le header
const headerStyles = [];
if (bg_color && !is_transparent) headerStyles.push(`background-color: ${bg_color}`);
if (bg_image) {
  headerStyles.push(`background-image: url(${bg_image})`);
  headerStyles.push(`background-size: cover`);
  headerStyles.push(`background-repeat: no-repeat`);
  headerStyles.push(`background-position: center`);
}

// Classes pour le header
const headerClasses = ['hero-section'];
if (is_transparent) headerClasses.push('hero-transparent');
if (is_sticky) headerClasses.push('hero-sticky');

// Style inline pour le header
const headerStyle = headerStyles.length > 0 ? headerStyles.join('; ') : '';


// Configuration du titre depuis les settings de section
const titleClasses = ['hero-content', ...getPositionClasses(align, vertical_align)];
%>

<header class="<%= headerClasses.join(' ') %>" <% if (headerStyle) { %>style="<%= headerStyle %>"<% } %>>
  <% if (bg_video) { %>
    <video class="section-bg-video" autoplay muted loop playsinline>
      <source src="<%= bg_video %>" type="video/mp4">
    </video>
  <% } else if (bg_youtube) { %>
    <%
      let videoId = '';
      try {
        if (bg_youtube.includes('youtu.be/')) {
          videoId = bg_youtube.split('youtu.be/')[1].split('?')[0].split('&')[0];
        } else if (bg_youtube.includes('youtube.com/watch')) {
          const url = new URL(bg_youtube);
          videoId = url.searchParams.get('v');
        }
      } catch (e) {}
    %>
    <% if (videoId) { %>
      <iframe class="section-bg-youtube" src="https://www.youtube.com/embed/<%= videoId %>?autoplay=1&mute=1&loop=1&playlist=<%= videoId %>&controls=0&rel=0&modestbranding=1&playsinline=1" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
    <% } %>
  <% } %>

  <div class="hero-grid">
    <!-- Logo -->
    <% if (logo_url) { %>
      <div class="<%= logoClasses.join(' ') %>" data-logo-width="<%= logo_width %>">
        <img src="<%= logo_url %>" alt="Logo">
      </div>
    <% } %>

    <!-- Liens de navigation -->
    <% if (show_nav_links && navElements && navElements.length > 0) { %>
      <nav class="<%= navClasses.join(' ') %>" data-nav-bg="<%= nav_bg_color %>" data-nav-color="<%= nav_text_color %>">
        <% navElements.forEach(navItem => { %>
          <a href="#section-<%= navItem.settings?.target_section_id %>"><%= navItem.settings?.label %></a>
        <% }); %>
      </nav>
    <% } %>

    <!-- Liens sociaux -->
    <% if (socialElements && socialElements.length > 0) { %>
      <div class="<%= socialClasses.join(' ') %>" data-social-color="<%= social_icon_color %>" data-social-size="<%= social_icon_size %>">
        <% socialElements.forEach(socialItem => { %>
          <a href="<%= socialItem.url || '#' %>" target="_blank" rel="noopener" title="<%= socialItem.type %>">
            <% 
              let faClass = '';
              switch(socialItem.type) {
                case 'facebook':
                  faClass = 'fab fa-facebook-f';
                  break;
                case 'instagram':
                  faClass = 'fab fa-instagram';
                  break;
                case 'youtube':
                  faClass = 'fab fa-youtube';
                  break;
                case 'twitter':
                  faClass = 'fab fa-twitter';
                  break;
                case 'linkedin':
                  faClass = 'fab fa-linkedin-in';
                  break;
                default:
                  faClass = 'fas fa-globe';
              }
            %>
            <i class="<%= faClass %>" style="color: <%= sectionTitleColor || '#ffffff' %>; font-size: <%= social_icon_size || 24 %>px;"></i>
          </a>
        <% }); %>
      </div>
    <% } %>

    <!-- Contenu principal -->
    <div class="<%= titleClasses.join(' ') %>">
      <% if (sectionTitle) { %>
        <h1 <% if (sectionTitleColor) { %>style="--hero-title-color: <%= sectionTitleColor %>"<% } %>><%= sectionTitle %></h1>
      <% } %>
    </div>
  </div>
</header>
