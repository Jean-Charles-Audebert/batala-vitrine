<%
/**
 * Composant Section Hero - Version simplifiée
 */

// Utiliser la nouvelle structure DB
const {
  title,
  subtitle,
  description,
  cta_label,
  cta_url,
  bg_color = '#1a1a1a',
  bg_image,
  is_transparent = false
} = section.content && section.content[0] ? section.content[0] : section;

// Styles pour le header
const headerStyles = [];
if (bg_color && !is_transparent) headerStyles.push(`background-color: ${bg_color}`);
if (bg_image) headerStyles.push(`background-image: url(${bg_image})`);

// Classes pour le header
const headerClasses = ['hero-section'];
if (is_transparent) headerClasses.push('hero-transparent');
%>

<header class="<%= headerClasses.join(' ') %>" <% if (headerStyles.length > 0) { %>style="<%= headerStyles.join('; ') %>"<% } %>>
  <div class="container">
    <!-- Titre principal -->
    <% if (title) { %>
      <h1 style="color: #ffffff;"><%= title %></h1>
    <% } %>
    <% if (subtitle) { %>
      <h2 style="color: #ffffff;"><%= subtitle %></h2>
    <% } %>
    <% if (description) { %>
      <p style="color: #ffffff;"><%= description %></p>
    <% } %>
    <% if (cta_label && cta_url) { %>
      <a href="<%= cta_url %>" class="btn btn-primary"><%= cta_label %></a>
    <% } %>
  </div>
</header>
