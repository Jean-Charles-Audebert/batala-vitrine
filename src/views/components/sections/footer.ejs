<%
// =====================================================
// Footer Section - Version nettoyée
// Lecture depuis: section.settings (JSONB) + elements
// =====================================================
const s = section.settings || {};

// --- SETTINGS (from JSONB) ---
// Background
const bg_color = s.bg_color || '#333333';
const bg_image = s.bg_image;
const bg_video = s.bg_video;
const bg_youtube = s.bg_youtube;
const is_transparent = s.bg_transparent || false;

// Footer content colors
const content_text_color = s.footer_content_color || s.content_text_color || '#ffffff';
const content_link_color = s.content_link_color || '#ffffff';
const footer_content_bg = s.footer_content_bg || '#2c2c2c';

// --- ELEMENTS (from elements table) ---
const id = section.id;
const navElements = section.elements?.filter(el => el.type === 'link' && el.settings?.link_type === 'navigation') || [];
const contactElement = section.elements?.find(el => el.type === 'contact') || null;

// Navigation config (from elements)
const nav_text_color = navElements[0]?.settings?.text_color || content_link_color;
const nav_bg_color = navElements[0]?.settings?.bg_color || 'transparent';

// Build styles
const bgStyle = [];
if (!is_transparent && bg_color) {
  bgStyle.push(`background-color: ${bg_color}`);
}
if (bg_image) {
  bgStyle.push(`background-image: url(${bg_image})`);
  bgStyle.push(`background-size: cover`);
  bgStyle.push(`background-position: center`);
}

const sectionClasses = ['section', 'section-footer'];
if (is_transparent) sectionClasses.push('section-transparent');
%>
<footer class="<%= sectionClasses.join(' ') %>" data-section-id="<%= id %>" <% if (bgStyle.length > 0) { %>style="<%= bgStyle.join('; ') %>"<% } %>>
  <!-- Arrière-plan média -->
  <% if (bg_youtube) { %>
    <%
      let videoId = '';
      try {
        if (bg_youtube.includes('youtu.be/')) {
          videoId = bg_youtube.split('youtu.be/')[1].split('?')[0].split('&')[0];
        } else if (bg_youtube.includes('youtube.com/watch')) {
          const url = new URL(bg_youtube);
          videoId = url.searchParams.get('v');
        } else if (bg_youtube.includes('youtube.com/embed/')) {
          videoId = bg_youtube.split('embed/')[1].split('?')[0].split('&')[0];
        } else if (bg_youtube.includes('youtube.com/shorts/')) {
          videoId = bg_youtube.split('shorts/')[1].split('?')[0].split('&')[0];
        }
      } catch (e) {}
    %>
    <% if (videoId) { %>
      <iframe class="section-bg-youtube" src="https://www.youtube.com/embed/<%= videoId %>?autoplay=1&mute=1&loop=1&playlist=<%= videoId %>&controls=0" frameborder="0" allowfullscreen style="pointer-events: none;"></iframe>
    <% } %>
  <% } else if (bg_video) { %>
    <video class="section-bg-video" autoplay muted loop playsinline>
      <source src="<%= bg_video %>" type="video/mp4">
    </video>
  <% } %>

 
  <div class="container" style="color: <%= content_text_color %>;">
    <div class="footer-content" style="background-color: <%= footer_content_bg %>;">
      <!-- Liens de navigation (from elements) -->
      <div class="footer-column footer-column--nav">
        <% if (navElements.length > 0) { %>
          <nav class="footer-nav" aria-label="Liens de navigation">
            <% navElements.forEach(navItem => { %>
              <a href="#section-<%= navItem.settings?.target_section_id %>" 
                 style="color: <%= nav_text_color %>;">
                <%= navItem.settings?.label %>
              </a>
            <% }); %>
          </nav>
        <% } %>
      </div>

      <!-- Bouton pour ouvrir la modale de contact -->
      <div class="footer-column footer-column--contact">
        <button class="btn-contact-modal" data-action="open-contact-modal">Contactez-nous</button>
      </div>

      <!-- Réseaux sociaux -->
      <div class="footer-column footer-column--social">
        <%- include('../social-links', { socialLinks, location: 'footer', user }) %>
      </div>
    </div>
      <!-- Ligne copyright -->
      <div class="footer-copyright">
        <p>&copy; 2025 <a href="https://caixadev.dev" target="_blank" rel="noopener noreferrer" style="color: inherit; text-decoration: underline;">caixaDev</a>. Tous droits réservés.</p>
      </div>
    
  </div>

  <!-- Inclusion de la modale de contact -->
  <%- include('../modals/contact-modal') %>
</footer>
