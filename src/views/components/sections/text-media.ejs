<%
/**
 * Composant Section Text + Media
 * Section avec du texte et une image/vidéo utilisant le système modulaire elements
 */

// Configuration de la section depuis settings JSONB
const sectionSettings = section.settings || {};
const {
  bg_color,
  bg_image,
  bg_video,
  bg_youtube,
  is_transparent,
  padding_top = 'medium',
  padding_bottom = 'medium'
} = sectionSettings;

const {
  id,
  title: sectionTitle,
  layout = {},
  elements = []
} = section;

// Extraire les éléments
const textElements = elements.filter(element => element.type === 'text');
const mediaElements = elements.filter(element => element.type === 'media' || element.type === 'photo');

// Prendre le premier élément de chaque type
const textElement = textElements[0];
const mediaElement = mediaElements[0];

const textSettings = textElement?.settings || {};
const mediaSettings = mediaElement?.settings || {};

// Styles pour la section
const sectionStyles = [];
if (bg_color && !is_transparent) sectionStyles.push(`background-color: ${bg_color}`);
if (bg_image) sectionStyles.push(`background-image: url(${bg_image})`);

const sectionClasses = [
  'section',
  'section-text-media',
  `section-text-media--${layout.type || 'image_left'}`,
  `padding-top-${padding_top}`,
  `padding-bottom-${padding_bottom}`
];
if (is_transparent) sectionClasses.push('section-transparent');
%>

<section
  class="<%= sectionClasses.join(' ') %>"
  data-section-id="<%= id %>"
  <% if (sectionStyles.length > 0) { %>style="<%= sectionStyles.join('; ') %>"<% } %>
>
  <div class="container">
    <% if (sectionTitle) { %>
      <div class="section-title-container">
        <h2 class="section-title"
            <%
              let titleStyle = [];
              if (section.title_font_id) titleStyle.push(`font-family: var(--font-${section.title_font_id})`);

              // Couleur par défaut blanche si vidéo de fond et pas de couleur définie
              let titleColor = section.title_color;
              if ((bg_video || bg_youtube) && !titleColor) {
                titleColor = '#ffffff';
              }
              if (titleColor) titleStyle.push(`color: ${titleColor}`);

              if (titleStyle.length > 0) {
            %>
            style="<%= titleStyle.join('; ') %>"
            <% } %>
            data-section-id="<%= id %>">
          <%= sectionTitle %>
        </h2>
      </div>
    <% } %>

    <div class="text-media-wrapper">
      <!-- Média (à gauche pour image_left) -->
      <% if (mediaElement && (layout.type === 'image_left' || !layout.type)) { %>
        <div class="text-media-media text-media-media--left">
          <div class="media-container">
            <% if (mediaSettings.video_url) { %>
              <div class="video-wrapper">
                <iframe
                  src="<%= mediaSettings.video_url.replace('watch?v=', 'embed/').replace('youtu.be/', 'youtube.com/embed/') %>"
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
            <% } else if (mediaSettings.url || mediaSettings.image_url) { %>
              <img src="<%= mediaSettings.url || mediaSettings.image_url %>" alt="<%= mediaSettings.alt || textSettings.title || 'Média' %>">
            <% } %>
          </div>
        </div>
      <% } %>

      <!-- Texte -->
      <div class="text-media-text">
        <% if (textElement) { %>
          <% if (textSettings.title || textElement.title) { %>
            <h3<% if (textSettings.font_id) { %> class="font-<%= textSettings.font_id %>"<% } %>><%= textSettings.title || textElement.title %></h3>
          <% } %>
          <% if (textSettings.content) { %>
            <div class="text-media-description"<% if (textSettings.font_id) { %> class="font-<%= textSettings.font_id %>"<% } %>><%= textSettings.content %></div>
          <% } %>
          <% if (textSettings.subtitle) { %>
            <p class="text-media-subtitle"<% if (textSettings.font_id) { %> class="font-<%= textSettings.font_id %>"<% } %>><%= textSettings.subtitle %></p>
          <% } %>
        <% } %>
      </div>
    </div>
  </div>
</section>