<%
/**
 * Composant Section Cartes
 * Section avec une grille de cartes
 */

const {
  title,
  description,
  cards = [],
  layout = 'grid',
  columns = 3,
  card_style = 'default',
  title_color = '#333333',
  text_color = '#666666',
  bg_color = '#ffffff',
  card_bg_color = '#ffffff',
  card_border_color = '#e0e0e0',
  card_shadow = true,
  card_rounded = true,
  title_font_id,
  text_font_id,
  text_font_size = 'medium',
  is_transparent = false,
  padding_top = 'medium',
  padding_bottom = 'medium'
} = section.data || section;

// Classes pour la section
const sectionClasses = ['cards-section'];
if (is_transparent) sectionClasses.push('section-transparent');

// Styles pour la section
const sectionStyles = [];
if (bg_color && !is_transparent) sectionStyles.push(`background-color: ${bg_color}`);

// Classes pour la grille
const gridClasses = [
  'cards-grid',
  `cards-grid--${layout}`,
  `cards-grid--cols-${columns}`
];

// Styles pour les cartes
const cardStyles = [];
if (card_bg_color) cardStyles.push(`background-color: ${card_bg_color}`);
if (card_border_color) cardStyles.push(`border-color: ${card_border_color}`);
if (card_shadow) cardStyles.push('box-shadow: 0 2px 8px rgba(0,0,0,0.1)');
if (card_rounded) cardStyles.push('border-radius: 8px');

// Styles pour le texte des cartes
const cardTextStyles = [];
if (text_color) cardTextStyles.push(`color: ${text_color}`);
if (text_font_id) cardTextStyles.push(`font-family: var(--font-${text_font_id})`);

// Taille de police
const fontSizeMap = { small: '0.9rem', medium: '1rem', large: '1.2rem', xl: '1.5rem' };
if (text_font_size && fontSizeMap[text_font_size]) {
  cardTextStyles.push(`font-size: ${fontSizeMap[text_font_size]}`);
}
%>

<section class="<%= sectionClasses.join(' ') %>" <% if (sectionStyles.length > 0) { %>style="<%= sectionStyles.join('; ') %>"<% } %>>
  <% if (mode === 'edit') { %>
    <div class="section-edit-overlay">
      <button class="edit-section-btn" data-section-id="<%= section.id %>">
        <img src="/icons/edit.svg" alt="" class="icon"> Modifier
      </button>
    </div>
  <% } %>
  <div class="container">
    <% if (title || description) { %>
      <div class="cards-header">
        <% if (title) { %>
          <h2 <% if (title_font_id) { %>style="font-family: var(--font-<%= title_font_id %>); color: <%= title_color %>;"<% } else { %>style="color: <%= title_color %>;"<% } %>>
            <%= title %>
          </h2>
        <% } %>
        <% if (description) { %>
          <p class="cards-description" <% if (cardTextStyles.length > 0) { %>style="<%= cardTextStyles.join('; ') %>"<% } %>>
            <%= description %>
          </p>
        <% } %>
      </div>
    <% } %>

    <% if (cards && cards.length > 0) { %>
      <div class="<%= gridClasses.join(' ') %>">
        <% cards.forEach((card, index) => { %>
          <div class="card card--<%= card_style %>" <% if (cardStyles.length > 0) { %>style="<%= cardStyles.join('; ') %>"<% } %>>
            <% if (card.image_url) { %>
              <div class="card-image">
                <img src="<%= card.image_url %>" alt="<%= card.title || 'Carte' %>">
              </div>
            <% } %>

            <div class="card-content">
              <% if (card.title) { %>
                <h3 class="card-title" <% if (cardTextStyles.length > 0) { %>style="<%= cardTextStyles.join('; ') %>"<% } %>>
                  <%= card.title %>
                </h3>
              <% } %>

              <% if (card.description) { %>
                <p class="card-description" <% if (cardTextStyles.length > 0) { %>style="<%= cardTextStyles.join('; ') %>"<% } %>>
                  <%= card.description %>
                </p>
              <% } %>

              <% if (card.link_url) { %>
                <a href="<%= card.link_url %>" class="card-link" <% if (cardTextStyles.length > 0) { %>style="<%= cardTextStyles.join('; ') %>"<% } %>>
                  <%= card.link_text || 'En savoir plus' %>
                </a>
              <% } %>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</section>