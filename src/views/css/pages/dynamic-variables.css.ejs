/**
 * Variables CSS dynamiques pour les polices et thèmes
 * Généré dynamiquement côté serveur
 */

:root {
  <% if (typeof pageData !== 'undefined' && pageData.page.title_font_id && pageData.fonts) { %>
    <% const titleFont = pageData.fonts.find(f => f.id == pageData.page.title_font_id); %>
    <% if (titleFont && titleFont.font_family) { %>
  --font-family-title: <%= titleFont.font_family.replace(/['"\\]/g, '') %>;
    <% } %>
  <% } %>

  <% if (typeof pageData !== 'undefined' && pageData.page.text_font_id && pageData.fonts) { %>
    <% const textFont = pageData.fonts.find(f => f.id == pageData.page.text_font_id); %>
    <% if (textFont && textFont.font_family) { %>
  --font-family-text: <%= textFont.font_family.replace(/['"\\]/g, '') %>;
    <% } %>
  <% } %>

  /* Variables pour les polices individuelles */
  <% if (typeof pageData !== 'undefined' && pageData.fonts && pageData.fonts.length > 0) { %>
    <% pageData.fonts.forEach(font => { %>
      <% if (font.font_family) { %>
  --font-<%= font.id %>: <%= font.font_family.replace(/['"\\]/g, '') %>;
      <% } %>
    <% }); %>
  <% } %>

  /* Variables pour les layouts */
  <% if (typeof pageData !== 'undefined' && pageData.page.main_bg_color) { %>
  --main-bg-color: <%= pageData.page.main_bg_color %>;
  <% } %>
}