/* Variables CSS dynamiques pour la page index-v2 */
:root {
  <% if (page.title_font_id && fonts) { %>
    <% const titleFont = fonts.find(f => f.id == page.title_font_id); %>
    <% if (titleFont && titleFont.font_family) { %>
  --font-family-title: <%= titleFont.font_family.replace(/['"\\]/g, '') %>;
    <% } %>
  <% } %>

  <% if (page.text_font_id && fonts) { %>
    <% const textFont = fonts.find(f => f.id == page.text_font_id); %>
    <% if (textFont && textFont.font_family) { %>
  --font-family-text: <%= textFont.font_family.replace(/['"\\]/g, '') %>;
    <% } %>
  <% } %>

  <% if (page.main_bg_color) { %>
  --main-bg-color: <%= page.main_bg_color %>;
  <% } %>

  <% if (page.main_title_color) { %>
  --main-title-color: <%= page.main_title_color %>;
  <% } %>

  /* Variables pour les polices individuelles */
  <% if (fonts && fonts.length > 0) { %>
    <% fonts.forEach(font => { %>
      <% if (font.font_family) { %>
  --font-<%= font.id %>: <%= font.font_family.replace(/['"\\]/g, '') %>;
      <% } %>
    <% }); %>
  <% } %>
}

/* Styles pour les polices individuelles */
<% if (fonts && fonts.length > 0) { %>
  <% fonts.forEach(font => { %>
    <% if (font.font_family) { %>
.font-<%= font.id %> {
  font-family: var(--font-<%= font.id %>, inherit) !important;
}
    <% } %>
  <% }); %>
<% } %>