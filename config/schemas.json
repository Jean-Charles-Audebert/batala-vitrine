{
  "global": {
    "label": "Configuration globale",
    "description": "Paramètres généraux du site",
    "icon": "⚙️",
    "fields": {
      "typography": {
        "type": "group",
        "label": "Typographie",
        "fields": {
          "title_font_id": {
            "type": "font",
            "label": "Police des titres",
            "default": 1
          }
        }
      },
      "background": {
        "type": "group",
        "label": "Fond principal",
        "fields": {
          "main_bg_color": {
            "type": "color",
            "label": "Couleur de fond",
            "default": "#ffffff"
          },
          "main_bg_image": {
            "type": "media",
            "label": "Image de fond",
            "accept": "image/*"
          },
          "main_bg_image_repeat": {
            "type": "select",
            "label": "Répétition de l'image",
            "options": [
              {"value": "no-repeat", "label": "Pas de répétition"},
              {"value": "repeat", "label": "Répéter"},
              {"value": "repeat-x", "label": "Répéter horizontalement"},
              {"value": "repeat-y", "label": "Répéter verticalement"}
            ],
            "default": "no-repeat"
          },
          "main_bg_image_size": {
            "type": "select",
            "label": "Taille de l'image",
            "options": [
              {"value": "auto", "label": "Taille originale"},
              {"value": "cover", "label": "Couvrir"},
              {"value": "contain", "label": "Contenir"},
              {"value": "100% 100%", "label": "Étirer"}
            ],
            "default": "cover"
          },
          "main_bg_video": {
            "type": "media",
            "label": "Vidéo de fond",
            "accept": "video/*"
          }
        }
      }
    }
  },
  "hero": {
    "label": "Header / Hero",
    "description": "Section d'en-tête avec logo, titre, navigation et médias de fond",
    "icon": "🏠",
    "fields": {
      "logo": {
        "type": "group",
        "label": "Logo",
        "fields": {
          "logo_url": {
            "type": "media",
            "label": "Image du logo",
            "accept": "image/*"
          },
          "logo_width": {
            "type": "number",
            "label": "Largeur du logo (px)",
            "min": 50,
            "max": 500,
            "default": 150
          },
          "logo_position_h": {
            "type": "select",
            "label": "Position horizontale",
            "options": [
              {"value": "left", "label": "Gauche"},
              {"value": "center", "label": "Centre"},
              {"value": "right", "label": "Droite"}
            ],
            "default": "center"
          },
          "logo_position_v": {
            "type": "select",
            "label": "Position verticale",
            "options": [
              {"value": "top", "label": "Haut"},
              {"value": "center", "label": "Centre"},
              {"value": "bottom", "label": "Bas"}
            ],
            "default": "center"
          }
        }
      },
      "content": {
        "type": "group",
        "label": "Contenu",
        "fields": {
          "title": {
            "type": "text",
            "label": "Titre principal",
            "placeholder": "Bienvenue sur notre site"
          },
          "subtitle": {
            "type": "text",
            "label": "Sous-titre",
            "placeholder": "Description courte"
          },
          "description": {
            "type": "textarea",
            "label": "Description",
            "placeholder": "Texte descriptif détaillé"
          },
          "cta_label": {
            "type": "text",
            "label": "Texte du bouton",
            "placeholder": "En savoir plus"
          },
          "cta_url": {
            "type": "url",
            "label": "Lien du bouton",
            "placeholder": "#contact"
          },
          "title_font_id": {
            "type": "font",
            "label": "Police du titre"
          },
          "title_color": {
            "type": "color",
            "label": "Couleur du titre",
            "default": "#ffffff"
          },
          "title_position_h": {
            "type": "select",
            "label": "Position horizontale du titre",
            "options": [
              {"value": "left", "label": "Gauche"},
              {"value": "center", "label": "Centre"},
              {"value": "right", "label": "Droite"}
            ],
            "default": "center"
          },
          "title_position_v": {
            "type": "select",
            "label": "Position verticale du titre",
            "options": [
              {"value": "top", "label": "Haut"},
              {"value": "center", "label": "Centre"},
              {"value": "bottom", "label": "Bas"}
            ],
            "default": "center"
          }
        }
      },
      "social": {
        "type": "group",
        "label": "Réseaux sociaux",
        "fields": {
          "show_social_links": {
            "type": "boolean",
            "label": "Afficher les icônes sociales"
          },
          "social_position_h": {
            "type": "select",
            "label": "Position horizontale",
            "options": [
              {"value": "left", "label": "Gauche"},
              {"value": "center", "label": "Centre"},
              {"value": "right", "label": "Droite"}
            ],
            "default": "right"
          },
          "social_position_v": {
            "type": "select",
            "label": "Position verticale",
            "options": [
              {"value": "top", "label": "Haut"},
              {"value": "center", "label": "Centre"},
              {"value": "bottom", "label": "Bas"}
            ],
            "default": "top"
          },
          "social_icon_size": {
            "type": "number",
            "label": "Taille des icônes (px)",
            "min": 16,
            "max": 64,
            "default": 24
          },
          "social_icon_color": {
            "type": "color",
            "label": "Couleur des icônes",
            "default": "#ffffff"
          }
        }
      },
      "navigation": {
        "type": "group",
        "label": "Navigation",
        "fields": {
          "show_nav_links": {
            "type": "boolean",
            "label": "Afficher la navigation"
          },
          "is_sticky": {
            "type": "boolean",
            "label": "Header fixe au scroll"
          },
          "nav_position_h": {
            "type": "select",
            "label": "Position horizontale",
            "options": [
              {"value": "left", "label": "Gauche"},
              {"value": "center", "label": "Centre"},
              {"value": "right", "label": "Droite"}
            ],
            "default": "right"
          },
          "nav_position_v": {
            "type": "select",
            "label": "Position verticale",
            "options": [
              {"value": "top", "label": "Haut"},
              {"value": "center", "label": "Centre"},
              {"value": "bottom", "label": "Bas"}
            ],
            "default": "center"
          },
          "nav_text_color": {
            "type": "color",
            "label": "Couleur du texte",
            "default": "#ffffff"
          },
          "nav_bg_color": {
            "type": "text",
            "label": "Couleur de fond (rgba)",
            "placeholder": "rgba(255,255,255,0.25)",
            "default": "rgba(255,255,255,0.25)"
          }
        }
      },
      "appearance": {
        "type": "group",
        "label": "Apparence",
        "fields": {
          "bg_color": {
            "type": "color",
            "label": "Couleur de fond",
            "default": "#1a1a1a"
          },
          "bg_image": {
            "type": "media",
            "label": "Image de fond",
            "accept": "image/*"
          },
          "bg_video": {
            "type": "media",
            "label": "Vidéo de fond (MP4)",
            "accept": "video/mp4"
          },
          "bg_youtube": {
            "type": "text",
            "label": "Vidéo YouTube",
            "placeholder": "https://youtu.be/... ou https://youtube.com/watch?v=..."
          },
          "is_transparent": {
            "type": "boolean",
            "label": "Fond transparent"
          },
          "padding_top": {
            "type": "select",
            "label": "Marge haute",
            "options": [
              {"value": "none", "label": "Aucune"},
              {"value": "small", "label": "Petite"},
              {"value": "medium", "label": "Moyenne"},
              {"value": "large", "label": "Grande"},
              {"value": "xl", "label": "Très grande"}
            ],
            "default": "large"
          },
          "padding_bottom": {
            "type": "select",
            "label": "Marge basse",
            "options": [
              {"value": "none", "label": "Aucune"},
              {"value": "small", "label": "Petite"},
              {"value": "medium", "label": "Moyenne"},
              {"value": "large", "label": "Grande"},
              {"value": "xl", "label": "Très grande"}
            ],
            "default": "large"
          }
        }
      }
    }
  },
  "textMedia": {
    "label": "Texte + Média",
    "description": "Section avec du texte et une image/vidéo",
    "icon": "📝",
    "fields": {
      "content": {
        "type": "group",
        "label": "Contenu",
        "fields": {
          "title": {
            "type": "text",
            "label": "Titre",
            "placeholder": "Titre de la section"
          },
          "description": {
            "type": "textarea",
            "label": "Texte",
            "placeholder": "Votre texte ici..."
          },
          "title_color": {
            "type": "color",
            "label": "Couleur du titre",
            "default": "#333333"
          },
          "text_color": {
            "type": "color",
            "label": "Couleur du texte",
            "default": "#666666"
          },
          "text_align": {
            "type": "select",
            "label": "Alignement du texte",
            "options": [
              {"value": "left", "label": "Gauche"},
              {"value": "center", "label": "Centre"},
              {"value": "right", "label": "Droite"}
            ],
            "default": "left"
          },
          "title_font_id": {
            "type": "font",
            "label": "Police du titre"
          },
          "text_font_id": {
            "type": "font",
            "label": "Police du texte"
          },
          "text_font_size": {
            "type": "select",
            "label": "Taille du texte",
            "options": [
              {"value": "small", "label": "Petit"},
              {"value": "medium", "label": "Normal"},
              {"value": "large", "label": "Grand"},
              {"value": "xl", "label": "Très grand"}
            ],
            "default": "medium"
          }
        }
      },
      "media": {
        "type": "group",
        "label": "Média",
        "fields": {
          "media_url": {
            "type": "media",
            "label": "Image ou vidéo",
            "accept": "image/*,video/*"
          },
          "media_type": {
            "type": "select",
            "label": "Type de média",
            "options": [
              {"value": "image", "label": "Image"},
              {"value": "video", "label": "Vidéo"},
              {"value": "youtube", "label": "YouTube"}
            ],
            "default": "image"
          },
          "media_position": {
            "type": "select",
            "label": "Position du média",
            "options": [
              {"value": "left", "label": "À gauche"},
              {"value": "right", "label": "À droite"},
              {"value": "center", "label": "Au centre"},
              {"value": "full", "label": "Pleine largeur"}
            ],
            "default": "right"
          },
          "media_size": {
            "type": "select",
            "label": "Taille du média",
            "options": [
              {"value": "small", "label": "Petit"},
              {"value": "medium", "label": "Moyen"},
              {"value": "large", "label": "Grand"},
              {"value": "xl", "label": "Plus grand"}
            ],
            "default": "medium"
          },
          "media_width_percent": {
            "type": "number",
            "label": "Largeur (%)",
            "min": 10,
            "max": 100,
            "default": 50
          }
        }
      },
      "appearance": {
        "type": "group",
        "label": "Apparence",
        "fields": {
          "bg_color": {
            "type": "color",
            "label": "Couleur de fond",
            "default": "#ffffff"
          },
          "is_transparent": {
            "type": "boolean",
            "label": "Fond transparent"
          },
          "padding_top": {
            "type": "select",
            "label": "Marge haute",
            "options": [
              {"value": "none", "label": "Aucune"},
              {"value": "small", "label": "Petite"},
              {"value": "medium", "label": "Moyenne"},
              {"value": "large", "label": "Grande"},
              {"value": "xl", "label": "Très grande"}
            ],
            "default": "medium"
          },
          "padding_bottom": {
            "type": "select",
            "label": "Marge basse",
            "options": [
              {"value": "none", "label": "Aucune"},
              {"value": "small", "label": "Petite"},
              {"value": "medium", "label": "Moyenne"},
              {"value": "large", "label": "Grande"},
              {"value": "xl", "label": "Très grande"}
            ],
            "default": "medium"
          }
        }
      }
    }
  },
  "cards": {
    "label": "Grille de cartes",
    "description": "Section avec une grille de cartes (services, produits, etc.)",
    "icon": "🎴",
    "fields": {
      "content": {
        "type": "group",
        "label": "Contenu",
        "fields": {
          "title": {
            "type": "text",
            "label": "Titre de la section",
            "placeholder": "Nos services"
          },
          "title_color": {
            "type": "color",
            "label": "Couleur du titre",
            "default": "#333333"
          },
          "title_font_id": {
            "type": "font",
            "label": "Police du titre"
          },
          "layout": {
            "type": "select",
            "label": "Disposition",
            "options": [
              {"value": "grid_2", "label": "2 colonnes"},
              {"value": "grid_3", "label": "3 colonnes"},
              {"value": "grid_4", "label": "4 colonnes"},
              {"value": "list", "label": "Liste verticale"}
            ],
            "default": "grid_3"
          }
        }
      },
      "cards": {
        "type": "array",
        "label": "Cartes",
        "itemLabel": "Carte",
        "minItems": 1,
        "fields": {
          "title": {
            "type": "text",
            "label": "Titre",
            "required": true,
            "placeholder": "Titre de la carte"
          },
          "description": {
            "type": "textarea",
            "label": "Description",
            "placeholder": "Description de la carte"
          },
          "media_url": {
            "type": "media",
            "label": "Image",
            "accept": "image/*"
          },
          "link_url": {
            "type": "url",
            "label": "Lien",
            "placeholder": "#contact"
          }
        }
      },
      "appearance": {
        "type": "group",
        "label": "Apparence",
        "fields": {
          "bg_color": {
            "type": "color",
            "label": "Couleur de fond",
            "default": "#f8f9fa"
          },
          "is_transparent": {
            "type": "boolean",
            "label": "Fond transparent"
          },
          "padding_top": {
            "type": "select",
            "label": "Marge haute",
            "options": [
              {"value": "none", "label": "Aucune"},
              {"value": "small", "label": "Petite"},
              {"value": "medium", "label": "Moyenne"},
              {"value": "large", "label": "Grande"},
              {"value": "xl", "label": "Très grande"}
            ],
            "default": "medium"
          },
          "padding_bottom": {
            "type": "select",
            "label": "Marge basse",
            "options": [
              {"value": "none", "label": "Aucune"},
              {"value": "small", "label": "Petite"},
              {"value": "medium", "label": "Moyenne"},
              {"value": "large", "label": "Grande"},
              {"value": "xl", "label": "Très grande"}
            ],
            "default": "medium"
          }
        }
      }
    }
  }
}